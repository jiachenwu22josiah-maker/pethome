<section class="video-feature section">
  <div class="container">

    <div class="video-feature__header">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subtext }}</p>
    </div>

    <div class="video-feature__player">
      {% if section.settings.video_type == 'youtube' and section.settings.youtube_url != blank %}
        {% assign video_id = section.settings.youtube_url | split: 'v=' | last | split: '&' | first %}
        <iframe
          src="https://www.youtube.com/embed/{{ video_id }}?autoplay=0&rel=0&modestbranding=1"
          title="{{ section.settings.heading }}"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy">
        </iframe>
      {% elsif section.settings.video_type == 'background' and section.settings.bg_video_url != blank %}
        <video autoplay muted loop playsinline class="video-bg">
          <source src="{{ section.settings.bg_video_url }}" type="video/mp4">
        </video>
      {% else %}
        <div class="video-placeholder">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
            <circle cx="12" cy="12" r="10"/>
            <polygon points="10 8 16 12 10 16 10 8" fill="currentColor" stroke="none"/>
          </svg>
          <p>Add a YouTube URL in theme settings</p>
        </div>
      {% endif %}
    </div>

    {% if section.settings.btn_text != blank %}
      <div class="video-feature__cta">
        <a href="{{ section.settings.btn_link }}" class="btn btn-dark">{{ section.settings.btn_text }}</a>
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Video Feature",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "Real Results" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See It In Action" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Watch real customers transform their smiles with Opalé whitening strips." },
    {
      "type": "select",
      "id": "video_type",
      "label": "Video type",
      "options": [
        { "value": "youtube", "label": "YouTube" },
        { "value": "background", "label": "Shopify-hosted MP4" }
      ],
      "default": "youtube"
    },
    { "type": "text", "id": "youtube_url", "label": "YouTube URL", "info": "Paste the full YouTube video URL, e.g. https://www.youtube.com/watch?v=XXXXX" },
    { "type": "text", "id": "bg_video_url", "label": "MP4 video URL", "info": "Upload video to Files in Shopify admin, paste the URL here" },
    { "type": "text", "id": "btn_text", "label": "Button text", "default": "Shop Whitening Strips" },
    { "type": "url", "id": "btn_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Video Feature" }]
}
{% endschema %}
