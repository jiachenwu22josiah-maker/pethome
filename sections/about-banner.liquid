<section class="about-banner section-padding">
  <div class="container">
    <div class="about-grid">
      <div class="about-content">
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text }}</p>

        <div class="about-stats">
          <div class="stat-item">
            <strong>{{ section.settings.stat1_number }}</strong>
            <span>{{ section.settings.stat1_label }}</span>
          </div>
          <div class="stat-item">
            <strong>{{ section.settings.stat2_number }}</strong>
            <span>{{ section.settings.stat2_label }}</span>
          </div>
          <div class="stat-item">
            <strong>{{ section.settings.stat3_number }}</strong>
            <span>{{ section.settings.stat3_label }}</span>
          </div>
        </div>

        <a href="{{ section.settings.btn_link }}" class="btn btn-white">{{ section.settings.btn_text }}</a>
      </div>

      <div class="about-image">
        {% if section.settings.image %}
          {{ section.settings.image | image_url: width: 800 | image_tag: loading: 'lazy' }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Banner",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Where Nature Meets Science" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "We believe your skin deserves the best nature has to offer. Every Petal & Pine formula is crafted from carefully sourced botanicals, free from harmful chemicals." },
    { "type": "text", "id": "stat1_number", "label": "Stat 1 number", "default": "50+" },
    { "type": "text", "id": "stat1_label", "label": "Stat 1 label", "default": "Natural Ingredients" },
    { "type": "text", "id": "stat2_number", "label": "Stat 2 number", "default": "10K+" },
    { "type": "text", "id": "stat2_label", "label": "Stat 2 label", "default": "Happy Customers" },
    { "type": "text", "id": "stat3_number", "label": "Stat 3 number", "default": "0" },
    { "type": "text", "id": "stat3_label", "label": "Stat 3 label", "default": "Harmful Chemicals" },
    { "type": "text", "id": "btn_text", "label": "Button text", "default": "Learn More" },
    { "type": "url", "id": "btn_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "presets": [{ "name": "About Banner" }]
}
{% endschema %}
