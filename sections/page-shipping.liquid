<div class="page-hero" style="background:var(--color-bg-green);padding:80px 0 48px;text-align:center;">
  <div class="container">
    <span style="font-size:0.75rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--color-primary);display:block;margin-bottom:12px;">Delivery</span>
    <h1 style="font-size:clamp(2rem,5vw,3.5rem);color:var(--color-primary-dark);">Shipping Information</h1>
  </div>
</div>

<div class="container" style="max-width:860px;padding:64px 24px;">

  <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;margin-bottom:56px;text-align:center;">
    <div style="background:var(--color-bg-green);border-radius:12px;padding:28px;">
      <div style="font-size:2rem;margin-bottom:10px;">📦</div>
      <strong style="color:var(--color-primary-dark);display:block;margin-bottom:4px;">1–3 Days</strong>
      <p style="font-size:0.8125rem;color:#666;margin:0;">Order processing time</p>
    </div>
    <div style="background:var(--color-bg-green);border-radius:12px;padding:28px;">
      <div style="font-size:2rem;margin-bottom:10px;">🚚</div>
      <strong style="color:var(--color-primary-dark);display:block;margin-bottom:4px;">Free Shipping</strong>
      <p style="font-size:0.8125rem;color:#666;margin:0;">On US orders over $50</p>
    </div>
    <div style="background:var(--color-bg-green);border-radius:12px;padding:28px;">
      <div style="font-size:2rem;margin-bottom:10px;">🌍</div>
      <strong style="color:var(--color-primary-dark);display:block;margin-bottom:4px;">Worldwide</strong>
      <p style="font-size:0.8125rem;color:#666;margin:0;">International shipping available</p>
    </div>
  </div>

  <h2 style="font-family:var(--font-heading);font-size:1.75rem;color:var(--color-primary-dark);margin-bottom:20px;">Shipping Rates & Delivery Times</h2>

  <table style="width:100%;border-collapse:collapse;margin-bottom:48px;font-size:0.9375rem;">
    <thead>
      <tr style="background:var(--color-primary-dark);color:white;">
        <th style="padding:14px 18px;text-align:left;border-radius:8px 0 0 0;">Method</th>
        <th style="padding:14px 18px;text-align:left;">Estimated Delivery</th>
        <th style="padding:14px 18px;text-align:left;border-radius:0 8px 0 0;">Cost</th>
      </tr>
    </thead>
    <tbody>
      <tr style="background:var(--color-bg-green);">
        <td style="padding:14px 18px;border-bottom:1px solid var(--color-border);"><strong>Free Standard (USA)</strong></td>
        <td style="padding:14px 18px;border-bottom:1px solid var(--color-border);">5–8 business days</td>
        <td style="padding:14px 18px;border-bottom:1px solid var(--color-border);color:var(--color-primary);font-weight:600;">FREE on orders $50+</td>
      </tr>
      <tr>
        <td style="padding:14px 18px;border-bottom:1px solid var(--color-border);">Standard Shipping (USA)</td>
        <td style="padding:14px 18px;border-bottom:1px solid var(--color-border);">5–8 business days</td>
        <td style="padding:14px 18px;border-bottom:1px solid var(--color-border);">$4.99</td>
      </tr>
      <tr style="background:var(--color-bg-green);">
        <td style="padding:14px 18px;border-bottom:1px solid var(--color-border);"><strong>Express Shipping (USA)</strong></td>
        <td style="padding:14px 18px;border-bottom:1px solid var(--color-border);">2–3 business days</td>
        <td style="padding:14px 18px;border-bottom:1px solid var(--color-border);">$12.99</td>
      </tr>
      <tr>
        <td style="padding:14px 18px;">International Shipping</td>
        <td style="padding:14px 18px;">10–20 business days</td>
        <td style="padding:14px 18px;">From $9.99</td>
      </tr>
    </tbody>
  </table>

  <h2 style="font-family:var(--font-heading);font-size:1.75rem;color:var(--color-primary-dark);margin-bottom:16px;">Order Tracking</h2>
  <p style="color:#555;line-height:1.9;margin-bottom:40px;">Once your order ships, you'll receive a confirmation email with a tracking number. Click the link in the email to track your package in real time.</p>

  <h2 style="font-family:var(--font-heading);font-size:1.75rem;color:var(--color-primary-dark);margin-bottom:16px;">International Orders</h2>
  <p style="color:#555;line-height:1.9;margin-bottom:40px;">We ship worldwide! International customers are responsible for any customs duties or import fees charged by their country. These are not included in our shipping rates.</p>

  <h2 style="font-family:var(--font-heading);font-size:1.75rem;color:var(--color-primary-dark);margin-bottom:16px;">Lost or Damaged?</h2>
  <p style="color:#555;line-height:1.9;margin-bottom:8px;">Contact us within 7 days of expected delivery with your order number and photos. We'll sort it out immediately.</p>
  <p style="color:#555;">📧 <a href="mailto:support@petalpine.com" style="color:var(--color-primary);">support@petalpine.com</a></p>

</div>

