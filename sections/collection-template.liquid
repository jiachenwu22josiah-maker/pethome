<div class="collection-header">
  <div class="container">
    <span class="eyebrow">Collection</span>
    <h1>{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <p>{{ collection.description }}</p>
    {% endif %}
  </div>
</div>

<div class="container">
  <div class="collection-toolbar">
    <div class="filter-tags">
      <button class="filter-tag active">All</button>
      {% for tag in collection.all_tags limit: 6 %}
        <button class="filter-tag">{{ tag }}</button>
      {% endfor %}
    </div>
    <select class="sort-select" name="sort_by">
      <option value="manual">Featured</option>
      <option value="best-selling">Best Selling</option>
      <option value="price-ascending">Price: Low → High</option>
      <option value="price-descending">Price: High → Low</option>
      <option value="created-descending">Newest</option>
    </select>
  </div>
</div>

<div class="container products-section">
  <p class="product-count">{{ collection.products_count }} products</p>
  <div class="grid-4">
    {% for product in collection.products %}
      {% render 'product-card', product: product %}
    {% else %}
      {% for i in (1..8) %}
        <div class="product-card">
          <div class="product-card__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          <div class="product-card__info">
            <a class="product-card__title">Sample Product {{ i }}</a>
            <div class="product-card__price"><span class="price">$48.00</span></div>
          </div>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</div>

{% schema %}
{ "name": "Collection Template", "settings": [] }
{% endschema %}
