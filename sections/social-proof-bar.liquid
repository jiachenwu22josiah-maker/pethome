<section class="social-proof-bar">
  <div class="container">
    <div class="social-proof-inner">

      <div class="social-proof-rating">
        <div class="stars">
          {% for i in (1..5) %}
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          {% endfor %}
        </div>
        <div class="rating-text">
          <strong>{{ section.settings.rating }}</strong>
          <span>{{ section.settings.review_count }}</span>
        </div>
      </div>

      <div class="social-proof-divider"></div>

      <div class="social-proof-stats">
        <div class="stat-item">
          <strong>{{ section.settings.stat1_number }}</strong>
          <span>{{ section.settings.stat1_label }}</span>
        </div>
        <div class="stat-item">
          <strong>{{ section.settings.stat2_number }}</strong>
          <span>{{ section.settings.stat2_label }}</span>
        </div>
        <div class="stat-item">
          <strong>{{ section.settings.stat3_number }}</strong>
          <span>{{ section.settings.stat3_label }}</span>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Social Proof Bar",
  "settings": [
    { "type": "text", "id": "rating", "label": "Star rating", "default": "4.9/5" },
    { "type": "text", "id": "review_count", "label": "Review count text", "default": "Based on 10,000+ reviews" },
    { "type": "text", "id": "stat1_number", "label": "Stat 1 number", "default": "10,000+" },
    { "type": "text", "id": "stat1_label", "label": "Stat 1 label", "default": "Happy Customers" },
    { "type": "text", "id": "stat2_number", "label": "Stat 2 number", "default": "7 Days" },
    { "type": "text", "id": "stat2_label", "label": "Stat 2 label", "default": "Visible Results" },
    { "type": "text", "id": "stat3_number", "label": "Stat 3 number", "default": "0%" },
    { "type": "text", "id": "stat3_label", "label": "Stat 3 label", "default": "Sensitivity" }
  ],
  "presets": [{ "name": "Social Proof Bar" }]
}
{% endschema %}
