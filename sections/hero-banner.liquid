<section class="hero">
  {% if section.settings.image %}
    <div class="hero-media">
      {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high' }}
    </div>
  {% endif %}
  <div class="container">
    <div class="hero-content">
      <span class="label label-gold">{{ section.settings.eyebrow }}</span>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.subtext }}</p>
      <div class="hero-actions">
        <a href="{{ section.settings.btn1_link }}" class="btn btn-white">{{ section.settings.btn1_text }}</a>
        <a href="{{ section.settings.btn2_link }}" class="btn btn-outline" style="border-color:rgba(255,255,255,0.4);color:white;">{{ section.settings.btn2_text }}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New Collection" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Skin That Speaks\nFor Itself." },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Advanced skincare formulated with the world's finest botanical and bio-active ingredients." },
    { "type": "text", "id": "btn1_text", "label": "Button 1", "default": "Shop Now" },
    { "type": "url", "id": "btn1_link", "label": "Button 1 link" },
    { "type": "text", "id": "btn2_text", "label": "Button 2", "default": "Discover More" },
    { "type": "url", "id": "btn2_link", "label": "Button 2 link" }
  ],
  "presets": [{ "name": "Hero Banner" }]
}
{% endschema %}
