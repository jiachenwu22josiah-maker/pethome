<section class="hero">
  <div class="hero-media">
    {% if section.settings.image %}
      {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high' }}
    {% else %}
      <div style="width:100%;height:100%;background:linear-gradient(135deg,#2A4A1E,#4A7C2F);"></div>
    {% endif %}
  </div>
  <div class="hero-overlay"></div>

  <div class="container">
    <div class="hero-content">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.subtext }}</p>
      <div class="hero-actions">
        <a href="{{ section.settings.btn1_link }}" class="btn btn-white">{{ section.settings.btn1_text }}</a>
        <a href="{{ section.settings.btn2_link }}" class="btn btn-outline" style="border-color:rgba(255,255,255,0.6);color:white;">{{ section.settings.btn2_text }}</a>
      </div>
    </div>
  </div>

  <div class="hero-badge">
    <strong>100%</strong>
    Natural<br>Ingredients
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Clean Beauty" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Nature's Purest Beauty, Bottled for You" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Formulated with botanical ingredients to nourish your skin, naturally." },
    { "type": "text", "id": "btn1_text", "label": "Button 1 text", "default": "Shop Now" },
    { "type": "url", "id": "btn1_link", "label": "Button 1 link" },
    { "type": "text", "id": "btn2_text", "label": "Button 2 text", "default": "Our Story" },
    { "type": "url", "id": "btn2_link", "label": "Button 2 link" }
  ],
  "presets": [{ "name": "Hero Banner" }]
}
{% endschema %}
