<!-- Email Popup — 2nd item 50% off -->
<div class="popup-overlay" id="popup-overlay"></div>

<div class="email-popup" id="email-popup" role="dialog" aria-modal="true">
  <button class="popup-close" id="popup-close" aria-label="Close">✕</button>

  <div class="popup-left">
    <div class="popup-badge">WELCOME OFFER</div>
    <div class="popup-discount">
      <span class="discount-big">50%</span>
      <span class="discount-label">OFF<br>2nd Item</span>
    </div>
    <p class="popup-tagline">Your skin deserves the best — so does your wallet.</p>
  </div>

  <div class="popup-right">
    <h3>Unlock Your Exclusive Offer</h3>
    <p>Enter your email to receive your <strong>Buy 1 Get 2nd 50% Off</strong> coupon code instantly.</p>

    <form class="popup-form" id="popup-form" onsubmit="claimOffer(event)">
      <input type="email" id="popup-email" placeholder="Your email address" required>
      <button type="submit" class="btn btn-primary btn-full">Get My Discount 🎁</button>
    </form>

    <div class="popup-coupon" id="popup-coupon">
      <p>Your exclusive code:</p>
      <div class="coupon-code" id="coupon-code" onclick="copyCoupon()">PINE50SECOND</div>
      <small>Tap to copy · Applies to 2nd item at checkout</small>
      <a href="/collections/all" class="btn btn-primary btn-full" style="margin-top:16px;">Shop Now →</a>
    </div>

    <p class="popup-privacy">🔒 No spam. Unsubscribe anytime.</p>
    <button class="popup-skip" onclick="closePopup()">No thanks, I'll pay full price</button>
  </div>
</div>

{% schema %}
{ "name": "Email Popup", "settings": [] }
{% endschema %}
