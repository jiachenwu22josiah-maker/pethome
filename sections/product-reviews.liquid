<section class="product-reviews section-padding" id="reviews">
  <div class="container">

    <!-- Reviews Header -->
    <div class="reviews-header">
      <div class="reviews-summary">
        <div class="reviews-score">
          <span class="score-number">4.8</span>
          <div class="score-stars">★★★★★</div>
          <span class="score-count">Based on {{ product.metafields.reviews.rating_count | default: '24' }} reviews</span>
        </div>
        <div class="score-bars">
          <div class="score-bar"><span>5 ★</span><div class="bar"><div class="bar-fill" style="width:78%"></div></div><span>78%</span></div>
          <div class="score-bar"><span>4 ★</span><div class="bar"><div class="bar-fill" style="width:14%"></div></div><span>14%</span></div>
          <div class="score-bar"><span>3 ★</span><div class="bar"><div class="bar-fill" style="width:5%"></div></div><span>5%</span></div>
          <div class="score-bar"><span>2 ★</span><div class="bar"><div class="bar-fill" style="width:2%"></div></div><span>2%</span></div>
          <div class="score-bar"><span>1 ★</span><div class="bar"><div class="bar-fill" style="width:1%"></div></div><span>1%</span></div>
        </div>
      </div>
      <button class="btn btn-primary" id="write-review-btn">Write a Review</button>
    </div>

    <!-- Review Form -->
    <div class="review-form-wrap" id="review-form-wrap">
      <h3>Share Your Experience</h3>
      <form class="review-form" id="review-form" onsubmit="submitReview(event)">

        <div class="form-row">
          <div class="form-group">
            <label>Your Name *</label>
            <input type="text" name="author" placeholder="Jane D." required>
          </div>
          <div class="form-group">
            <label>Email *</label>
            <input type="email" name="email" placeholder="jane@example.com" required>
          </div>
        </div>

        <div class="form-group">
          <label>Rating *</label>
          <div class="star-picker" id="star-picker">
            <span class="star-opt" data-val="1">★</span>
            <span class="star-opt" data-val="2">★</span>
            <span class="star-opt" data-val="3">★</span>
            <span class="star-opt" data-val="4">★</span>
            <span class="star-opt" data-val="5">★</span>
          </div>
          <input type="hidden" name="rating" id="rating-input" value="0">
        </div>

        <div class="form-group">
          <label>Review Title *</label>
          <input type="text" name="title" placeholder="e.g. Amazing results in 2 weeks!" required>
        </div>

        <div class="form-group">
          <label>Your Review *</label>
          <textarea name="body" rows="4" placeholder="Tell us about your experience with this product..." required></textarea>
        </div>

        <div class="form-group">
          <label>Add Photos (optional)</label>
          <div class="photo-upload-area" id="photo-upload-area">
            <input type="file" id="photo-input" accept="image/*" multiple style="display:none">
            <div class="upload-placeholder" onclick="document.getElementById('photo-input').click()">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
              <span>Click to upload photos</span>
              <small>JPG, PNG up to 5MB each · Max 3 photos</small>
            </div>
            <div class="photo-previews" id="photo-previews"></div>
          </div>
        </div>

        <div class="form-actions">
          <button type="button" class="btn btn-outline" onclick="closeReviewForm()">Cancel</button>
          <button type="submit" class="btn btn-primary">Submit Review</button>
        </div>

      </form>
      <div class="review-success" id="review-success">
        <div class="success-icon">✓</div>
        <h4>Thank you for your review!</h4>
        <p>Your review has been submitted and will appear after approval.</p>
      </div>
    </div>

    <!-- Reviews List -->
    <div class="reviews-list" id="reviews-list">

      <!-- Sample reviews -->
      <div class="review-card">
        <div class="review-top">
          <div class="reviewer-avatar">S</div>
          <div class="reviewer-info">
            <span class="reviewer-name">Sarah M. <span class="verified-badge">✓ Verified</span></span>
            <span class="review-date">May 2025</span>
          </div>
          <div class="review-stars">★★★★★</div>
        </div>
        <h4 class="review-title">Completely transformed my skin!</h4>
        <p class="review-body">I've been using this serum for 6 weeks now and the results are incredible. My skin is so much brighter and my dark spots have visibly faded. I love that it's all natural and vegan. Will definitely repurchase!</p>
        <div class="review-helpful">
          <span>Helpful?</span>
          <button class="helpful-btn" onclick="markHelpful(this)">👍 Yes (12)</button>
        </div>
      </div>

      <div class="review-card">
        <div class="review-top">
          <div class="reviewer-avatar">E</div>
          <div class="reviewer-info">
            <span class="reviewer-name">Emily R. <span class="verified-badge">✓ Verified</span></span>
            <span class="review-date">April 2025</span>
          </div>
          <div class="review-stars">★★★★★</div>
        </div>
        <h4 class="review-title">Best serum I've ever tried</h4>
        <p class="review-body">Lightweight, absorbs quickly and smells amazing. My skin feels plumper and more hydrated after just one week. The PDRN technology is real — you can feel it working. Highly recommend to anyone looking for a clean beauty serum.</p>
        <div class="review-helpful">
          <span>Helpful?</span>
          <button class="helpful-btn" onclick="markHelpful(this)">👍 Yes (8)</button>
        </div>
      </div>

      <div class="review-card">
        <div class="review-top">
          <div class="reviewer-avatar">J</div>
          <div class="reviewer-info">
            <span class="reviewer-name">Jessica T. <span class="verified-badge">✓ Verified</span></span>
            <span class="review-date">March 2025</span>
          </div>
          <div class="review-stars">★★★★☆</div>
        </div>
        <h4 class="review-title">Great product, fast delivery</h4>
        <p class="review-body">Really happy with this purchase. Packaging is gorgeous and the serum itself is lovely. Giving 4 stars only because I wish it came in a larger size! My skin looks noticeably more even-toned after 3 weeks.</p>
        <div class="review-helpful">
          <span>Helpful?</span>
          <button class="helpful-btn" onclick="markHelpful(this)">👍 Yes (5)</button>
        </div>
      </div>

    </div>

  </div>
</section>

{% schema %}
{ "name": "Product Reviews", "settings": [] }
{% endschema %}
