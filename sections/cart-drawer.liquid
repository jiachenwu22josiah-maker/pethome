<div class="cart-drawer" id="cart-drawer" aria-label="Shopping cart">
  <div class="cart-drawer__header">
    <h3>Your Cart ({{ cart.item_count }})</h3>
    <button class="cart-close header-icon-btn" id="cart-close" aria-label="Close cart">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <div class="cart-drawer__body">
    {% if cart.item_count == 0 %}
      <div class="cart-empty">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <h4>Your cart is empty</h4>
        <p>Add your favourite products to get started.</p>
        <a href="/collections/all" class="btn btn-primary">Shop Now</a>
      </div>
    {% else %}
      {% for item in cart.items %}
        <div class="cart-item">
          <div class="cart-item__image">
            <a href="{{ item.url }}">
              {{ item.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: item.title }}
            </a>
          </div>
          <div class="cart-item__info">
            <div class="cart-item__title">{{ item.product.title }}</div>
            {% unless item.variant.title == 'Default Title' %}
              <div class="cart-item__variant">{{ item.variant.title }}</div>
            {% endunless %}
            <div class="cart-item__controls">
              <div class="qty-control">
                <button class="qty-btn" data-qty-minus aria-label="Decrease">−</button>
                <input class="qty-input" type="number" value="{{ item.quantity }}" min="1" readonly>
                <button class="qty-btn" data-qty-plus aria-label="Increase">+</button>
              </div>
              <span class="cart-item__price">{{ item.line_price | money }}</span>
            </div>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>

  {% if cart.item_count > 0 %}
    <div class="cart-drawer__footer">
      <div class="cart-subtotal">
        <span>Subtotal</span>
        <strong>{{ cart.total_price | money }}</strong>
      </div>
      <p class="cart-note">Shipping & taxes calculated at checkout</p>
      <a href="/checkout" class="btn btn-primary cart-checkout">Checkout</a>
      <a href="/cart" class="btn btn-outline btn-full" style="margin-top:8px;">View Cart</a>
    </div>
  {% endif %}
</div>

{% schema %}
{ "name": "Cart Drawer", "settings": [] }
{% endschema %}
